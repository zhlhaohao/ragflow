echo -n '请输入版本号:'
read img_ver

echo -n '是否构建镜像 (y/n)'
read flag
if [ "$flag" = "y" -o "$flag" = "Y" ] ; then
  docker build --build-arg NEED_MIRROR=1 -f /home/lianghao/github/ragflow/Dockerfile -t ragflow:cheetah-$img_ver /home/lianghao/github/ragflow
fi

echo -n '是否上传到pot (y/n)'
read flag
if [ "$flag" = "y" -o "$flag" = "Y" ] ; then
  docker tag ragflow:cheetah-$img_ver 10.119.101.20:9869/ragflow:cheetah-$img_ver
  docker push 10.119.101.20:9869/ragflow:cheetah-$img_ver
fi
