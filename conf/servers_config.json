{
  "mcpServers": {
    "time": {
      "command": "uv",
      "args": ["run", "mcp-server-time", "--local-timezone=Asia/Shanghai"]
    },
    "web-search": {
      "command": "uv",
      "args": [
        "run", 
        "mcps/servers/web_search/mcp_web_search.py",
        "--jina-url", "https://r.jina.ai/",
        "--searxng-url", "http://127.0.0.1:8088/"
      ]
    }
  }
}